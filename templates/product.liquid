{% comment %}
  Template: product.liquid
  Ficha de producto detallada con selector de talla, galería e interacción directa
{% endcomment %}

<div class="container section-padding">
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:start;">

    <!-- Product Gallery -->
    <div>
      <div style="border-radius:var(--radius-lg); overflow:hidden; border:1px solid var(--border-light);">
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" style="width:100%; object-fit:cover;">
      </div>

      {% if product.images.size > 1 %}
        <div style="display:flex; gap:12px; margin-top:16px; overflow-x:auto;">
          {% for image in product.images %}
            <img src="{{ image | image_url: width: 150 }}" alt="{{ product.title | escape }}" style="width:80px; height:80px; object-fit:cover; border-radius:var(--radius-sm); border:2px solid var(--border-light); cursor:pointer;">
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info -->
    <div>
      <span class="product-category-name" style="display:block; margin-bottom:8px;">{{ product.type }}</span>
      <h1 style="font-size:2rem; margin-bottom:12px;">{{ product.title }}</h1>

      <div style="color:var(--color-warning); font-weight:700; font-size:1.1rem; margin-bottom:16px;">
        ★★★★★ <span style="color:var(--text-muted); font-weight:400; font-size:0.88rem;">(Producto Verificado Cuppets)</span>
      </div>

      <div class="product-price-row" style="margin-bottom:20px;">
        <span class="current-price" style="font-size:1.8rem;">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="old-price" style="font-size:1.1rem;">{{ product.compare_at_price | money }}</span>
          <span class="product-badge-tag tag-discount" style="position:static; font-size:0.8rem;">
            -{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% OFF
          </span>
        {% endif %}
      </div>

      <div style="color:var(--text-muted); font-size:0.95rem; margin-bottom:24px; line-height:1.7;">
        {{ product.description }}
      </div>

      <!-- Product Form -->
      <product-form>
        <form action="/cart/add" method="post" enctype="multipart/form-data">
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div style="margin-bottom:16px;">
                <label style="font-weight:700; display:block; margin-bottom:8px;">{{ option.name }}:</label>
                <div class="size-selector-grid" style="display:flex; gap:10px; flex-wrap:wrap;">
                  {% for value in option.values %}
                    <label style="cursor:pointer;">
                      <input type="radio" name="option-{{ option.name | handle }}" value="{{ value | escape }}" {% if forloop.first %}checked{% endif %} style="display:none;">
                      <span class="size-btn" style="display:inline-block; padding:10px 18px; border:1px solid var(--border-purple); border-radius:var(--radius-sm); font-weight:700; font-size:0.9rem;">{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <select name="id" id="product-variant-select" style="display:none;">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>

          <!-- Engraving Custom Field (for customizable products) -->
          {% if product.tags contains 'personalizable' %}
            <div style="margin-bottom:16px; padding:16px; background:var(--bg-secondary); border-radius:var(--radius-md); border:1px solid var(--border-purple);">
              <label style="font-weight:700; display:block; margin-bottom:8px;"><i class="fa-solid fa-wand-magic-sparkles"></i> Grabado Personalizado:</label>
              <input type="text" name="properties[Nombre Grabado]" placeholder="Nombre de tu mascota (ej: Luna, Max)" maxlength="14" style="width:100%; padding:12px 16px; border:1px solid var(--border-light); border-radius:var(--radius-md);">
              <input type="text" name="properties[Teléfono Grabado]" placeholder="Teléfono de contacto" maxlength="15" style="width:100%; padding:12px 16px; border:1px solid var(--border-light); border-radius:var(--radius-md); margin-top:8px;">
            </div>
          {% endif %}

          <!-- Quantity Selector -->
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
            <label style="font-weight:700;">Cantidad:</label>
            <div class="qty-controls" style="display:flex; align-items:center; border:1px solid var(--border-purple); border-radius:var(--radius-full); overflow:hidden;">
              <button type="button" class="qty-btn" onclick="this.parentNode.querySelector('input').stepDown(); this.parentNode.querySelector('input').dispatchEvent(new Event('change'));" style="width:36px; height:36px; background:transparent; border:none; font-weight:700; cursor:pointer; color:var(--primary-purple);">-</button>
              <input type="number" name="quantity" value="1" min="1" max="10" style="width:50px; text-align:center; border:none; font-weight:700; font-size:1rem;">
              <button type="button" class="qty-btn" onclick="this.parentNode.querySelector('input').stepUp(); this.parentNode.querySelector('input').dispatchEvent(new Event('change'));" style="width:36px; height:36px; background:transparent; border:none; font-weight:700; cursor:pointer; color:var(--primary-purple);">+</button>
            </div>
          </div>

          <div style="display:flex; gap:12px;">
            <button type="submit" class="btn btn-purple btn-lg" style="flex:1;">
              <i class="fa-solid fa-basket-shopping"></i> Añadir a la Canasta
            </button>
            <a href="https://wa.me/{{ settings.whatsapp_number | default: '573233056221' }}?text=Hola%20Cuppets!%20Quiero%20comprar:%20{{ product.title | url_encode }}%20-%20{{ product.price | money }}" target="_blank" class="btn btn-whatsapp-link btn-lg">
              <i class="fa-brands fa-whatsapp"></i> WhatsApp
            </a>
          </div>
        </form>
      </product-form>

      <!-- Trust Badges inline -->
      <div style="display:flex; gap:20px; margin-top:24px; padding-top:20px; border-top:1px solid var(--border-light);">
        <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; color:var(--text-muted);">
          <i class="fa-solid fa-shield-check" style="color:var(--primary-purple);"></i> Garantía 1 Año
        </div>
        <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; color:var(--text-muted);">
          <i class="fa-solid fa-truck-fast" style="color:var(--primary-purple);"></i> Envío 24-48h
        </div>
        <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; color:var(--text-muted);">
          <i class="fa-solid fa-arrows-rotate" style="color:var(--primary-purple);"></i> Cambio de Talla Gratis
        </div>
      </div>
    </div>
  </div>
</div>
