      <div id="catalog-no-results" style="display: none; text-align: center; padding: 60px 20px; background: #FAF9FE; border-radius: var(--radius-lg); margin-top: 20px; border: 1.5px dashed var(--border-color);">
        <i class="fa-solid fa-paw" style="font-size: 2.5rem; color: var(--brand-purple); margin-bottom: 12px; display: block;"></i>
        <h3 style="color: var(--brand-navy); font-size: 1.25rem; margin-bottom: 6px;">No se encontraron accesorios en esta categoría</h3>
