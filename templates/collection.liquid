{% comment %}
  Template: collection.liquid
  Catálogo completo de Cuppets con filtros laterales interactivos y grid de productos
{% endcomment %}

{% assign current_pet = 'all' %}
{% if collection.handle contains 'perro' or request.path contains 'perro' %}
  {% assign current_pet = 'dog' %}
{% elsif collection.handle contains 'gato' or request.path contains 'gato' %}
  {% assign current_pet = 'cat' %}
{% endif %}

<div class="catalog-hero-header" style="background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-secondary) 100%); padding: 48px 0; border-bottom: 1px solid var(--border-color);">
  <div class="container">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
      <div>
        <span class="section-subtitle">
          {% if current_pet == 'dog' %}
            <i class="fa-solid fa-dog"></i> COLECCIÓN CANINA
          {% elsif current_pet == 'cat' %}
            <i class="fa-solid fa-cat"></i> COLECCIÓN FELINA
          {% else %}
            <i class="fa-solid fa-sparkles"></i> CATÁLOGO OFICIAL
          {% endif %}
        </span>
        <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 3.5vw, 2.6rem); color: var(--brand-navy); margin-top: 6px;">
          {{ collection.title | default: 'Todos los Accesorios Cuppets' }}
        </h1>
        <p style="color: var(--text-muted); margin-top: 8px; max-width: 600px;">
          {{ collection.description | default: 'Explora nuestra selección premium de accesorios ergonómicos, collares acolchados, arneses y camas para consentir a tu mejor amigo.' }}
        </p>
      </div>

      <!-- Quick Species Filter Switcher -->
      <div class="species-switcher" style="box-shadow: var(--shadow-sm); background: white; border: 1px solid var(--border-color);">
        <button class="switcher-btn {% if current_pet == 'all' %}active{% endif %}" onclick="filterCatalogByPet('all', this)">
          <i class="fa-solid fa-border-all"></i> Todos
        </button>
        <button class="switcher-btn {% if current_pet == 'dog' %}active{% endif %}" onclick="filterCatalogByPet('dog', this)">
          <i class="fa-solid fa-dog"></i> Perros
        </button>
        <button class="switcher-btn {% if current_pet == 'cat' %}active{% endif %}" onclick="filterCatalogByPet('cat', this)">
          <i class="fa-solid fa-cat"></i> Gatos
        </button>
      </div>
    </div>
  </div>
</div>

<div class="container section-padding">
  <div class="catalog-layout-grid" style="display: grid; grid-template-columns: 270px 1fr; gap: 36px; align-items: start;">
    
    <!-- Sidebar Filters -->
    <aside class="catalog-filters-sidebar">
      <div class="filter-panel" style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-xs);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
          <h3 style="font-family:var(--font-body); font-size: 1.1rem; font-weight:700; color: var(--brand-navy);"><i class="fa-solid fa-sliders" style="color: var(--brand-purple);"></i> Filtros</h3>
          <button onclick="resetCatalogFilters()" style="background:none; border:none; font-size:0.85rem; color:var(--brand-purple); font-weight:600; cursor:pointer;">Restablecer</button>
        </div>

        <!-- Mascota Type -->
        <div style="margin-bottom:24px;">
          <h4 style="font-size:0.88rem; font-weight:700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--brand-navy); margin-bottom:12px;">Especie</h4>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <button class="filter-link-btn {% if current_pet == 'all' %}active{% endif %}" onclick="filterCatalogByPet('all', this)">
              🐾 Todos los animales
            </button>
            <button class="filter-link-btn {% if current_pet == 'dog' %}active{% endif %}" onclick="filterCatalogByPet('dog', this)">
              🐶 Para Perros
            </button>
            <button class="filter-link-btn {% if current_pet == 'cat' %}active{% endif %}" onclick="filterCatalogByPet('cat', this)">
              🐱 Para Gatos
            </button>
          </div>
        </div>

        <!-- Category Types -->
        <div style="margin-bottom:24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
          <h4 style="font-size:0.88rem; font-weight:700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--brand-navy); margin-bottom:12px;">Categoría</h4>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <button class="filter-link-btn active" data-cat="all" onclick="filterCatalogByCategory('all', this)">
              ⭐ Todas las categorías
            </button>
            <button class="filter-link-btn" data-cat="arneses" onclick="filterCatalogByCategory('arneses', this)">
              🦺 Arneses &amp; Pecheras
            </button>
            <button class="filter-link-btn" data-cat="collares" onclick="filterCatalogByCategory('collares', this)">
              🏷️ Collares &amp; Placas
            </button>
            <button class="filter-link-btn" data-cat="correas" onclick="filterCatalogByCategory('correas', this)">
              🪢 Correas de Paseo
            </button>
            <button class="filter-link-btn" data-cat="camas" onclick="filterCatalogByCategory('camas', this)">
              🛏️ Camas &amp; Descanso
            </button>
          </div>
        </div>

        <!-- Sort -->
        <div style="padding-top: 16px; border-top: 1px solid var(--border-color);">
          <h4 style="font-size:0.88rem; font-weight:700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--brand-navy); margin-bottom:12px;">Ordenar</h4>
          <select id="catalog-sort-select" onchange="sortCatalogProducts(this.value)" style="width:100%; padding:10px 14px; border:1px solid var(--border-color); border-radius:var(--radius-md); background: #FAF9FE; font-weight: 500; font-size: 0.9rem; color: var(--brand-navy);">
            <option value="featured">Destacados Cuppets</option>
            <option value="price-asc">Precio: Menor a Mayor</option>
            <option value="price-desc">Precio: Mayor a Menor</option>
            <option value="rating">Mejor Calificados</option>
          </select>
        </div>
      </div>
    </aside>

    <!-- Product Grid Column -->
    <div class="catalog-products-column">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <p style="color:var(--text-muted); font-size: 0.92rem;" id="catalog-counter-text">
          Mostrando <strong style="color: var(--brand-navy);" id="catalog-visible-count">8</strong> accesorios
        </p>
      </div>

      <div class="products-grid" id="catalog-products-grid">
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            {% assign pet_type = 'all' %}
            {% if product.tags contains 'perro' or product.tags contains 'Perro' or product.title contains 'Perro' or product.title contains 'perro' %}
              {% assign pet_type = 'dog' %}
            {% elsif product.tags contains 'gato' or product.tags contains 'Gato' or product.title contains 'Gato' or product.title contains 'gato' %}
              {% assign pet_type = 'cat' %}
            {% endif %}
            <div class="catalog-product-item" data-pet-type="{{ pet_type }}" data-category="{{ product.type | handleize }}">
              {% render 'product-card', product: product %}
            </div>
          {% endfor %}
        {% else %}
