{% comment %}
  Template: collection.liquid
  Catálogo completo de Cuppets con filtros laterales interactivos y grid de productos
{% endcomment %}

{% assign current_pet = 'all' %}
{% if collection.handle contains 'perro' or request.path contains 'perro' %}
  {% assign current_pet = 'dog' %}
{% elsif collection.handle contains 'gato' or request.path contains 'gato' %}
  {% assign current_pet = 'cat' %}
{% endif %}

<div class="catalog-hero-header" style="background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-secondary) 100%); padding: 48px 0; border-bottom: 1px solid var(--border-color);">
  <div class="container">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
      <div>
        <span class="section-subtitle" id="catalog-hero-badge">
          {% if current_pet == 'dog' %}
            <i class="fa-solid fa-dog"></i> COLECCIÓN CANINA
          {% elsif current_pet == 'cat' %}
            <i class="fa-solid fa-cat"></i> COLECCIÓN FELINA
          {% else %}
            <i class="fa-solid fa-sparkles"></i> CATÁLOGO OFICIAL
          {% endif %}
        </span>
        <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 3.5vw, 2.6rem); color: var(--brand-navy); margin-top: 6px;" id="catalog-hero-title">
          {{ collection.title | default: 'Todos los Accesorios Cuppets' }}
        </h1>
        <p style="color: var(--text-muted); margin-top: 8px; max-width: 600px;">
          {{ collection.description | default: 'Explora nuestra selección premium de accesorios ergonómicos, collares acolchados, arneses y camas para consentir a tu mejor amigo.' }}
        </p>
      </div>

      <!-- Quick Species Filter Switcher -->
      <div class="species-switcher" style="box-shadow: var(--shadow-sm); background: white; border: 1px solid var(--border-color);">
        <button class="switcher-btn {% if current_pet == 'all' %}active{% endif %}" data-pet="all" data-type="all" onclick="filterCatalogByPet('all', this)">
          <i class="fa-solid fa-border-all"></i> Todos
        </button>
        <button class="switcher-btn {% if current_pet == 'dog' %}active{% endif %}" data-pet="dog" data-type="dog" onclick="filterCatalogByPet('dog', this)">
          <i class="fa-solid fa-dog"></i> Perros
        </button>
        <button class="switcher-btn {% if current_pet == 'cat' %}active{% endif %}" data-pet="cat" data-type="cat" onclick="filterCatalogByPet('cat', this)">
          <i class="fa-solid fa-cat"></i> Gatos
        </button>
      </div>
    </div>
  </div>
</div>

<div class="container section-padding">
  <div class="catalog-layout-grid" style="display: grid; grid-template-columns: 270px 1fr; gap: 36px; align-items: start;">
    
    <!-- Sidebar Filters -->
    <aside class="catalog-filters-sidebar">
      <div class="filter-panel" style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-xs);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
          <h3 style="font-family:var(--font-body); font-size: 1.1rem; font-weight:700; color: var(--brand-navy);"><i class="fa-solid fa-sliders" style="color: var(--brand-purple);"></i> Filtros</h3>
          <button onclick="resetCatalogFilters()" style="background:none; border:none; font-size:0.85rem; color:var(--brand-purple); font-weight:600; cursor:pointer;">Restablecer</button>
        </div>

        <!-- Mascota Type -->
        <div style="margin-bottom:24px;">
          <h4 style="font-size:0.88rem; font-weight:700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--brand-navy); margin-bottom:12px;">Especie</h4>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <button class="filter-link-btn {% if current_pet == 'all' %}active{% endif %}" data-pet="all" onclick="filterCatalogByPet('all', this)">
              🐾 Todos los animales
            </button>
            <button class="filter-link-btn {% if current_pet == 'dog' %}active{% endif %}" data-pet="dog" onclick="filterCatalogByPet('dog', this)">
              🐶 Para Perros
            </button>
            <button class="filter-link-btn {% if current_pet == 'cat' %}active{% endif %}" data-pet="cat" onclick="filterCatalogByPet('cat', this)">
              🐱 Para Gatos
            </button>
          </div>
        </div>

        <!-- Category Types -->
        <div style="margin-bottom:24px; padding-top: 16px; border-top: 1px solid var(--border-color);">
          <h4 style="font-size:0.88rem; font-weight:700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--brand-navy); margin-bottom:12px;">Categoría</h4>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <button class="filter-link-btn active" data-cat="all" onclick="filterCatalogByCategory('all', this)">
              ⭐ Todas las categorías
            </button>
            <button class="filter-link-btn" data-cat="arneses" onclick="filterCatalogByCategory('arneses', this)">
              🦺 Arneses &amp; Pecheras
            </button>
            <button class="filter-link-btn" data-cat="collares" onclick="filterCatalogByCategory('collares', this)">
              🏷️ Collares &amp; Placas
            </button>
            <button class="filter-link-btn" data-cat="correas" onclick="filterCatalogByCategory('correas', this)">
              🪢 Correas de Paseo
            </button>
            <button class="filter-link-btn" data-cat="camas" onclick="filterCatalogByCategory('camas', this)">
              🛏️ Camas &amp; Descanso
            </button>
            <button class="filter-link-btn" data-cat="juguetes" onclick="filterCatalogByCategory('juguetes', this)">
              🧸 Juguetes &amp; Entretenimiento
            </button>
            <button class="filter-link-btn" data-cat="higiene" onclick="filterCatalogByCategory('higiene', this)">
              🧴 Higiene &amp; Cuidado
            </button>
            <button class="filter-link-btn" data-cat="promociones" onclick="filterCatalogByCategory('promociones', this)" style="background: linear-gradient(135deg, var(--brand-purple-soft) 0%, #fff8e7 100%); border: 1.5px solid var(--brand-honey); font-weight: 700;">
              🔥 Promociones &amp; Combos
            </button>
          </div>
        </div>

        <!-- Sort -->
        <div style="padding-top: 16px; border-top: 1px solid var(--border-color);">
          <h4 style="font-size:0.88rem; font-weight:700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--brand-navy); margin-bottom:12px;">Ordenar</h4>
          <select id="catalog-sort-select" onchange="sortCatalogProducts(this.value)" style="width:100%; padding:10px 14px; border:1px solid var(--border-color); border-radius:var(--radius-md); background: #FAF9FE; font-weight: 500; font-size: 0.9rem; color: var(--brand-navy);">
            <option value="featured">Destacados Cuppets</option>
            <option value="price-asc">Precio: Menor a Mayor</option>
            <option value="price-desc">Precio: Mayor a Menor</option>
            <option value="rating">Mejor Calificados</option>
          </select>
        </div>
      </div>
    </aside>

    <!-- Product Grid Column -->
    <div class="catalog-products-column">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <p style="color:var(--text-muted); font-size: 0.92rem;" id="catalog-counter-text">
          Mostrando <strong style="color: var(--brand-navy);" id="catalog-visible-count">8</strong> accesorios
        </p>
      </div>

      <div class="products-grid" id="catalog-products-grid">
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            {% assign pet_type = 'all' %}
            {% assign prod_text = product.title | append: ' ' | append: product.description | append: ' ' | append: product.tags | append: ' ' | append: product.type | downcase %}
            
            {% if prod_text contains 'perro' or prod_text contains 'canin' or prod_text contains 'dog' or prod_text contains 'cachorro' %}
              {% if prod_text contains 'gato' or prod_text contains 'felin' or prod_text contains 'cat' or prod_text contains 'michi' %}
                {% assign pet_type = 'both' %}
              {% else %}
                {% assign pet_type = 'dog' %}
              {% endif %}
            {% elsif prod_text contains 'gato' or prod_text contains 'felin' or prod_text contains 'cat' or prod_text contains 'michi' or prod_text contains 'minino' %}
              {% assign pet_type = 'cat' %}
            {% endif %}

            {% assign prod_cat = 'accesorios' %}
            {% if prod_text contains 'combo' or prod_text contains 'promo' or prod_text contains 'kit ' or prod_text contains 'set ' or prod_text contains 'pack' or prod_text contains 'descuento' or prod_text contains 'oferta' %}
              {% assign prod_cat = 'promociones' %}
            {% elsif prod_text contains 'dient' or prod_text contains 'dental' or prod_text contains 'cepillo' or prod_text contains 'sarro' or prod_text contains 'higien' or prod_text contains 'shampoo' or prod_text contains 'cortauna' or prod_text contains 'limpia' or prod_text contains 'baño' or prod_text contains 'jabon' or prod_text contains 'peine' or prod_text contains 'grooming' %}
              {% assign prod_cat = 'higiene' %}
            {% elsif prod_text contains 'arnes' or prod_text contains 'pecher' or prod_text contains 'chaleco' %}
              {% assign prod_cat = 'arneses' %}
            {% elsif prod_text contains 'collar' or prod_text contains 'chapa' or prod_text contains 'medalla' or prod_text contains 'identificad' or prod_text contains 'tag' or prod_text contains 'placa' %}
              {% assign prod_cat = 'collares' %}
            {% elsif prod_text contains 'correa' or prod_text contains 'paseo' or prod_text contains 'lazo' or prod_text contains 'guia' %}
              {% assign prod_cat = 'correas' %}
            {% elsif prod_text contains 'cama' or prod_text contains 'cueva' or prod_text contains 'iglu' or prod_text contains 'colchon' or prod_text contains 'cojin' or prod_text contains 'descanso' %}
              {% assign prod_cat = 'camas' %}
            {% elsif prod_text contains 'juguet' or prod_text contains 'pelota' or prod_text contains 'cuerda' or prod_text contains 'rascador' or prod_text contains 'interactiv' or prod_text contains 'mordedor' or prod_text contains 'peluche' %}
              {% assign prod_cat = 'juguetes' %}
            {% endif %}

            <div class="catalog-product-item" data-pet-type="{{ pet_type }}" data-category="{{ prod_cat }}" data-price="{{ product.price | divided_by: 100.0 }}" data-rating="5" data-title="{{ product.title | escape }}">
              {% render 'product-card', product: product %}
            </div>
          {% endfor %}
        {% else %}
          <!-- 🔥 PROMOCIONES / COMBOS -->
          <div class="catalog-product-item" data-pet-type="both" data-category="promociones" data-price="89000" data-rating="5" data-title="Combo Paseo Perro: Arnés + Correa + Collar">
            <div class="product-card">
              <span class="product-badge-tag" style="background: linear-gradient(135deg, var(--brand-purple), var(--brand-honey)); color:#fff;">🔥 COMBO · PROMO ESPECIAL</span>
              <div class="product-image-wrapper">
                <a href="/collections/all?category=promociones">
                  <img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=600&q=80" alt="Combo Paseo Perro" class="product-img" loading="lazy">
                </a>
              </div>
              <div class="product-details">
                <span class="product-category-name"><i class="fa-solid fa-tags"></i> Combo Paseo Completo</span>
                <a href="/collections/all?category=promociones" class="product-title-link">Combo Paseo Perro: Arnés + Correa + Collar</a>
                <div class="product-rating-stars">★★★★★ <span class="review-count">(97)</span></div>
                <div class="product-price-row">
                  <span class="current-price">$89.000 COP</span>
                  <span class="old-price">$135.000 COP</span>
                </div>
                <div class="product-card-actions">
                  <button class="btn-add-cart" onclick="window.addInteractiveCartItem('combo-paseo-dog', 'Combo Paseo Perro: Arnés+Correa+Collar 🔥', 89000, 'https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=300&q=80', 'Perro')">
                    <i class="fa-solid fa-basket-shopping"></i> + Añadir
                  </button>
                  <button class="btn-wa-direct" onclick="window.open('https://wa.me/573233056221?text=Hola%20Cuppets!%20Quiero%20el%20Combo%20Paseo%20Perro', '_blank')" title="Pedir por WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="catalog-product-item" data-pet-type="both" data-category="promociones" data-price="75000" data-rating="5" data-title="Kit Esencial Gato: Pechera + Correa + Collar">
            <div class="product-card">
              <span class="product-badge-tag" style="background: linear-gradient(135deg, var(--brand-purple), var(--brand-honey)); color:#fff;">🔥 COMBO · AHORRA 40%</span>
              <div class="product-image-wrapper">
                <a href="/collections/all?category=promociones">
                  <img src="https://images.unsplash.com/photo-1573865526739-10659fec78a5?auto=format&fit=crop&w=600&q=80" alt="Kit Esencial Gato" class="product-img" loading="lazy">
                </a>
              </div>
              <div class="product-details">
                <span class="product-category-name"><i class="fa-solid fa-tags"></i> Kit Esencial Felino</span>
                <a href="/collections/all?category=promociones" class="product-title-link">Kit Esencial Gato: Pechera + Correa + Collar</a>
                <div class="product-rating-stars">★★★★★ <span class="review-count">(62)</span></div>
                <div class="product-price-row">
                  <span class="current-price">$75.000 COP</span>
                  <span class="old-price">$124.000 COP</span>
                </div>
                <div class="product-card-actions">
                  <button class="btn-add-cart" onclick="window.addInteractiveCartItem('kit-esencial-cat', 'Kit Esencial Gato: Pechera+Correa+Collar 🔥', 75000, 'https://images.unsplash.com/photo-1573865526739-10659fec78a5?auto=format&fit=crop&w=300&q=80', 'Gato')">
                    <i class="fa-solid fa-basket-shopping"></i> + Añadir
                  </button>
                  <button class="btn-wa-direct" onclick="window.open('https://wa.me/573233056221?text=Hola%20Cuppets!%20Quiero%20el%20Kit%20Esencial%20Gato', '_blank')" title="Pedir por WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- 🐶 PERROS PRODUCTS -->
          <div class="catalog-product-item" data-pet-type="dog" data-category="arneses" data-price="69900" data-rating="5" data-title="Arnés Anti-Tirones Acolchado Reflectivo">
            <div class="product-card">
              <span class="product-badge-tag badge-dog">🐶 PERROS · MÁS VENDIDO</span>
              <div class="product-image-wrapper">
                <a href="/collections/all?pet=dog">
                  <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=600&q=80" alt="Arnés Ergonómico Pro Dog" class="product-img" loading="lazy">
                </a>
              </div>
              <div class="product-details">
                <span class="product-category-name"><i class="fa-solid fa-vest"></i> Arnés Ergonómico Pro</span>
                <a href="/collections/all?pet=dog" class="product-title-link">Arnés Anti-Tirones Acolchado Reflectivo</a>
                <div class="product-rating-stars">★★★★★ <span class="review-count">(128)</span></div>
                <div class="product-price-row">
                  <span class="current-price">$69.900 COP</span>
                  <span class="old-price">$89.900 COP</span>
                </div>
                <div class="product-card-actions">
                  <button class="btn-add-cart" onclick="window.addInteractiveCartItem('arnes-pro-dog', 'Arnés Anti-Tirones Reflectivo 🐶', 69900, 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=300&q=80', 'Perro')">
                    <i class="fa-solid fa-basket-shopping"></i> + Añadir
                  </button>
                  <button class="btn-wa-direct" onclick="window.open('https://wa.me/573233056221?text=Hola%20Cuppets!%20Quiero%20comprar%20el%20Arnes%20Anti-Tirones%20Reflectivo%20para%20Perro', '_blank')" title="Pedir por WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="catalog-product-item" data-pet-type="dog" data-category="collares" data-price="45000" data-rating="5" data-title="Collar Impermeable Hipoalergénico con Placa">
            <div class="product-card">
              <span class="product-badge-tag badge-dog">🐶 PERROS · PREMIUM</span>
              <div class="product-image-wrapper">
                <a href="/collections/all?pet=dog">
                  <img src="https://images.unsplash.com/photo-1535294435445-d7249524ef2e?auto=format&fit=crop&w=600&q=80" alt="Collar Acolchado Padded Dog" class="product-img" loading="lazy">
                </a>
              </div>
              <div class="product-details">
                <span class="product-category-name"><i class="fa-solid fa-tag"></i> Collar Soft-Padded</span>
                <a href="/collections/all?pet=dog" class="product-title-link">Collar Impermeable Hipoalergénico con Placa</a>
                <div class="product-rating-stars">★★★★★ <span class="review-count">(94)</span></div>
                <div class="product-price-row">
                  <span class="current-price">$45.000 COP</span>
                  <span class="old-price">$55.000 COP</span>
                </div>
                <div class="product-card-actions">
                  <button class="btn-add-cart" onclick="window.addInteractiveCartItem('collar-padded-dog', 'Collar Impermeable Hipoalergénico 🐶', 45000, 'https://images.unsplash.com/photo-1535294435445-d7249524ef2e?auto=format&fit=crop&w=300&q=80', 'Perro')">
                    <i class="fa-solid fa-basket-shopping"></i> + Añadir
                  </button>
                  <button class="btn-wa-direct" onclick="window.open('https://wa.me/573233056221?text=Hola%20Cuppets!%20Quiero%20el%20Collar%20Impermeable%20Hipoalergenico%20para%20Perro', '_blank')" title="Pedir por WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="catalog-product-item" data-pet-type="dog" data-category="correas" data-price="52000" data-rating="5" data-title="Correa Manos Libres Elástica Anti-Impacto">
            <div class="product-card">
              <span class="product-badge-tag badge-dog">🐶 PERROS · PASEO</span>
              <div class="product-image-wrapper">
                <a href="/collections/all?pet=dog">
                  <img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=600&q=80" alt="Correa Manos Libres Dog" class="product-img" loading="lazy">
                </a>
              </div>
              <div class="product-details">
                <span class="product-category-name"><i class="fa-solid fa-route"></i> Correa de Paseo</span>
                <a href="/collections/all?pet=dog" class="product-title-link">Correa Manos Libres Elástica Anti-Impacto</a>
                <div class="product-rating-stars">★★★★★ <span class="review-count">(86)</span></div>
                <div class="product-price-row">
                  <span class="current-price">$52.000 COP</span>
                  <span class="old-price">$65.000 COP</span>
                </div>
                <div class="product-card-actions">
                  <button class="btn-add-cart" onclick="window.addInteractiveCartItem('correa-manos-libres-dog', 'Correa Manos Libres Elástica 🐶', 52000, 'https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=300&q=80', 'Perro')">
                    <i class="fa-solid fa-basket-shopping"></i> + Añadir
                  </button>
                  <button class="btn-wa-direct" onclick="window.open('https://wa.me/573233056221?text=Hola%20Cuppets!%20Quiero%20la%20Correa%20Manos%20Libres%20para%20Perro', '_blank')" title="Pedir por WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="catalog-product-item" data-pet-type="dog" data-category="camas" data-price="120000" data-rating="5" data-title="Cama Memory Foam Calmante Antiestrés">
            <div class="product-card">
              <span class="product-badge-tag badge-dog">🐶 PERROS · DESCANSO</span>
              <div class="product-image-wrapper">
                <a href="/collections/all?pet=dog">
                  <img src="https://images.unsplash.com/photo-1541599540903-216a46ca1dc0?auto=format&fit=crop&w=600&q=80" alt="Cama Ortopédica Memory Foam Dog" class="product-img" loading="lazy">
                </a>
              </div>
              <div class="product-details">
                <span class="product-category-name"><i class="fa-solid fa-bed"></i> Cama Ortopédica</span>
                <a href="/collections/all?pet=dog" class="product-title-link">Cama Memory Foam Calmante Antiestrés</a>
                <div class="product-rating-stars">★★★★★ <span class="review-count">(162)</span></div>
                <div class="product-price-row">
                  <span class="current-price">$120.000 COP</span>
                  <span class="old-price">$145.000 COP</span>
                </div>
                <div class="product-card-actions">
                  <button class="btn-add-cart" onclick="window.addInteractiveCartItem('cama-memory-dog', 'Cama Memory Foam Calmante 🐶', 120000, 'https://images.unsplash.com/photo-1541599540903-216a46ca1dc0?auto=format&fit=crop&w=300&q=80', 'Perro')">
                    <i class="fa-solid fa-basket-shopping"></i> + Añadir
                  </button>
                  <button class="btn-wa-direct" onclick="window.open('https://wa.me/573233056221?text=Hola%20Cuppets!%20Quiero%20la%20Cama%20Memory%20Foam%20para%20Perro', '_blank')" title="Pedir por WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- 🐱 GATOS PRODUCTS -->
          <div class="catalog-product-item" data-pet-type="cat" data-category="collares" data-price="38000" data-rating="5" data-title="Collar Velvet Antiahogo con Placa y Cascabel">
            <div class="product-card">
              <span class="product-badge-tag badge-cat">🐱 GATOS · TOP SEGURIDAD</span>
              <div class="product-image-wrapper">
                <a href="/collections/all?pet=cat">
                  <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=600&q=80" alt="Collar Antiahogo Velvet Cat" class="product-img" loading="lazy">
                </a>
              </div>
              <div class="product-details">
                <span class="product-category-name"><i class="fa-solid fa-cat"></i> Collar Antiahogo</span>
                <a href="/collections/all?pet=cat" class="product-title-link">Collar Velvet Antiahogo con Placa y Cascabel</a>
                <div class="product-rating-stars">★★★★★ <span class="review-count">(110)</span></div>
                <div class="product-price-row">
                  <span class="current-price">$38.000 COP</span>
                  <span class="old-price">$48.000 COP</span>
