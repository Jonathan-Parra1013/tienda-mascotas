                  <button class="btn-wa-direct" onclick="window.open('https://wa.me/573233056221?text=Hola%20Cuppets!%20Quiero%20comprar%20el%20Arnes%20Anti-Tirones%20Reflectivo%20para%20Perro', '_blank')" title="Pedir por WhatsApp">
