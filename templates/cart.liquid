{% comment %}
  Template: cart.liquid
  Página de carrito (fallback cuando el drawer no es suficiente)
{% endcomment %}

<div class="container section-padding">
  <h1 style="font-family:var(--font-display); font-size:2.4rem; margin-bottom:32px;">Tu Canasta Cuppets 🐾</h1>

  {% if cart.item_count > 0 %}
    <form action="/cart" method="post" novalidate>
      <div style="display:grid; grid-template-columns:1fr 360px; gap:40px;">

        <!-- Cart Items -->
        <div>
          {% for item in cart.items %}
            <div class="cart-item" style="display:flex; gap:16px; padding:20px; background:var(--bg-secondary); border-radius:var(--radius-md); border:1px solid var(--border-light); margin-bottom:16px;">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width:100px; height:100px; object-fit:cover; border-radius:var(--radius-sm);">
              <div style="flex:1;">
                <a href="{{ item.url }}" style="font-weight:700; font-size:1rem; color:var(--text-dark);">{{ item.product.title }}</a>
                <p style="font-size:0.85rem; color:var(--text-muted);">{{ item.variant.title }}</p>
                {% for property in item.properties %}
                  {% if property.last != blank %}
                    <p style="font-size:0.82rem; color:var(--primary-purple);">✨ {{ property.first }}: {{ property.last }}</p>
                  {% endif %}
                {% endfor %}
                <p style="font-weight:800; color:var(--primary-dark); margin-top:6px;">{{ item.final_line_price | money }}</p>
                <div style="display:flex; align-items:center; gap:12px; margin-top:8px;">
                  <div class="qty-controls" style="display:flex; align-items:center; border:1px solid var(--border-purple); border-radius:var(--radius-full);">
                    <button type="button" class="qty-btn" onclick="window.shopifyCart.changeItem('{{ item.key }}', {{ item.quantity | minus: 1 }})" style="width:28px; height:28px; background:none; border:none; cursor:pointer; color:var(--primary-purple); font-weight:700;">-</button>
                    <span style="padding:0 10px; font-weight:700;">{{ item.quantity }}</span>
                    <button type="button" class="qty-btn" onclick="window.shopifyCart.changeItem('{{ item.key }}', {{ item.quantity | plus: 1 }})" style="width:28px; height:28px; background:none; border:none; cursor:pointer; color:var(--primary-purple); font-weight:700;">+</button>
                  </div>
                  <button type="button" onclick="window.shopifyCart.changeItem('{{ item.key }}', 0)" style="background:none; border:none; color:var(--color-danger); cursor:pointer;"><i class="fa-regular fa-trash-can"></i> Eliminar</button>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Cart Summary -->
        <div style="background:#fff; border:1px solid var(--border-purple); border-radius:var(--radius-lg); padding:32px; align-self:start;">
          <h3 style="font-family:var(--font-body); font-weight:700; margin-bottom:20px;">Resumen del Pedido</h3>
          <div style="display:flex; justify-content:space-between; margin-bottom:10px; font-size:0.95rem;">
            <span>Subtotal ({{ cart.item_count }} artículos)</span>
            <span style="font-weight:700;">{{ cart.total_price | money }}</span>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:16px; font-size:0.95rem;">
            <span>Envío</span>
            <span style="color:var(--color-success); font-weight:600;">{% if cart.total_price > 9900000 %}GRATIS{% else %}Calculado en checkout{% endif %}</span>
          </div>
          <hr style="border:none; border-top:1px solid var(--border-light); margin-bottom:16px;">
          <div style="display:flex; justify-content:space-between; font-size:1.2rem; font-weight:800; margin-bottom:24px;">
            <span>Total</span>
            <span style="color:var(--primary-dark);">{{ cart.total_price | money }}</span>
          </div>

          {% if customer %}
            <a href="/checkout" class="btn btn-purple btn-lg" style="width:100%; margin-bottom:12px; justify-content: center;">
              <i class="fa-solid fa-lock"></i> Finalizar Compra Segura
            </a>
          {% else %}
            <button type="button" class="btn btn-purple btn-lg" onclick="requireLoginForCheckout()" style="width:100%; margin-bottom:12px; justify-content: center; border:none; cursor:pointer;">
              <i class="fa-solid fa-lock"></i> Iniciar Sesión para Comprar
            </button>
          {% endif %}
          <button type="button" class="btn btn-whatsapp-full" style="width:100%; background:#25D366; color:#fff; border:none; padding:14px; border-radius:var(--radius-full); font-weight:600; cursor:pointer;" onclick="checkoutViaWhatsApp()">
            <i class="fa-brands fa-whatsapp"></i> Pedir por WhatsApp
          </button>
          <a href="/collections/all" style="display:block; text-align:center; margin-top:12px; color:var(--primary-purple); font-size:0.9rem;">← Seguir Comprando</a>
        </div>
      </div>
    </form>
  {% else %}
    <div style="text-align:center; padding:80px 20px;">
      <i class="fa-solid fa-basket-shopping" style="font-size:4rem; color:var(--border-purple); margin-bottom:20px;"></i>
      <h2>Tu canasta está vacía</h2>
      <p style="color:var(--text-muted); margin-bottom:24px;">Explora nuestros accesorios para perros y gatos.</p>
      <a href="/collections/all" class="btn btn-purple btn-lg">Explorar Catálogo Cuppets</a>
    </div>
  {% endif %}
</div>
