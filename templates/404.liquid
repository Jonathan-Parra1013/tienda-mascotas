{% comment %}
  Template: 404.liquid
  Página de error 404 personalizada para Cuppets con auto-redirección inteligente
{% endcomment %}

<script>
  (function() {
    var path = window.location.pathname.toLowerCase();
    if (path.indexOf('sobre-nosotros') !== -1 || path.indexOf('about') !== -1) {
      window.location.replace('/#sobre-nosotros');
      return;
    }
    if (path.indexOf('/collections/') !== -1) {
      if (path.indexOf('perro') !== -1) {
        window.location.replace('/collections/all?pet=dog');
      } else if (path.indexOf('gato') !== -1) {
        window.location.replace('/collections/all?pet=cat');
      } else if (path.indexOf('arnes') !== -1) {
        window.location.replace('/collections/all?category=arneses');
      } else if (path.indexOf('collar') !== -1) {
        window.location.replace('/collections/all?category=collares');
      } else if (path.indexOf('correa') !== -1) {
        window.location.replace('/collections/all?category=correas');
      } else if (path.indexOf('cama') !== -1) {
        window.location.replace('/collections/all?category=camas');
      } else {
        window.location.replace('/collections/all');
      }
    }
  })();
</script>

{% render 'breadcrumbs' %}

<div class="container section-padding text-center" style="max-width: 600px; margin: 0 auto; padding-top: 60px; padding-bottom: 80px;">
  <div style="font-size: 5rem; margin-bottom: 20px; animation: float 3s ease-in-out infinite;">
    🐶🔍
  </div>
  <span class="badge badge-purple" style="margin-bottom: 16px;">ERROR 404</span>
  <h1 style="font-family: var(--font-display); font-size: 2.2rem; color: var(--primary-dark); margin-bottom: 12px;">
    ¡Ups! Este rastro se ha perdido
  </h1>
  <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 32px; line-height: 1.6;">
    No pudimos encontrar la página que buscas. Tal vez tu peludito escondió el enlace o el producto ya no está disponible.
  </p>
  <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
    <a href="{{ routes.root_url }}" class="btn btn-primary">
      Volver al Inicio
    </a>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-secondary">
      Ver Todo el Catálogo
    </a>
  </div>
</div>
