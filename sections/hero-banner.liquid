<section class="hero-ref-banner" id="hero-banner">
  <div class="hero-ref-backdrop" style="background-image: url('{{ 'hero-pets-bg.jpg' | asset_url }}');">
    <div class="hero-ref-overlay"></div>
  </div>

  <div class="container hero-ref-container">
    <div class="hero-ref-content">
      <!-- Glass Pill Badge -->
      <div class="hero-ref-badge">
        <i class="fa-solid fa-paw"></i>
        <span>{{ section.settings.hero_badge | default: 'Accesorio premium para mascotas' }}</span>
      </div>

      <!-- Main Heading -->
      <h1 class="hero-ref-title">
        {{ section.settings.hero_title_line1 | default: 'El amor que' }}<br>
        <span class="hero-ref-title-italic">{{ section.settings.hero_title_line2 | default: 'merecen' }}</span>
      </h1>

      <!-- Description Subtext -->
      <p class="hero-ref-desc">
        {{ section.settings.hero_subtext | default: 'Accesorios de calidad para perros y gatos. Diseñados con amor, pensados para su bienestar.' }}
      </p>

      <!-- CTA Action Buttons -->
      <div class="hero-ref-actions">
        <a href="{{ section.settings.btn_primary_url | default: '/collections/all' }}" class="btn-ref-primary">
          {{ section.settings.btn_primary_text | default: 'Ver catálogo' }}
        </a>
        <a href="{{ section.settings.btn_secondary_url | default: '/pages/sobre-nosotros' }}" class="btn-ref-secondary">
          {{ section.settings.btn_secondary_text | default: 'Conócenos' }}
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Stats Counter Bar (Reference Style) -->
  <div class="hero-ref-stats-bar">
    <div class="container">
      <div class="stats-bar-grid">
        <div class="stat-col">
          <span class="stat-num">{{ section.settings.stat_1_num | default: '10K+' }}</span>
          <span class="stat-lbl">{{ section.settings.stat_1_lbl | default: 'Mascotas felices' }}</span>
        </div>
        <div class="stat-col">
          <span class="stat-num">{{ section.settings.stat_2_num | default: '200+' }}</span>
          <span class="stat-lbl">{{ section.settings.stat_2_lbl | default: 'Productos' }}</span>
        </div>
        <div class="stat-col">
          <span class="stat-num">{{ section.settings.stat_3_num | default: '4.9★' }}</span>
          <span class="stat-lbl">{{ section.settings.stat_3_lbl | default: 'Valoración media' }}</span>
        </div>
        <div class="stat-col">
          <span class="stat-num">{{ section.settings.stat_4_num | default: 'Gratis' }}</span>
          <span class="stat-lbl">{{ section.settings.stat_4_lbl | default: 'Envío desde $50' }}</span>
        </div>
      </div>
    </div>
    <button class="hero-stats-help-btn" onclick="openSearchModal()" title="¿Necesitas ayuda? Buscar en catálogo" aria-label="Ayuda">
      <i class="fa-solid fa-question"></i>
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Principal",
  "settings": [
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Texto de la insignia superior",
      "default": "Accesorio premium para mascotas"
    },
    {
      "type": "text",
      "id": "hero_title_line1",
      "label": "Título Línea 1",
      "default": "El amor que"
    },
    {
      "type": "text",
      "id": "hero_title_line2",
      "label": "Título Línea 2 (Cursiva)",
      "default": "merecen"
    },
    {
      "type": "textarea",
      "id": "hero_subtext",
      "label": "Descripción",
      "default": "Accesorios de calidad para perros y gatos. Diseñados con amor, pensados para su bienestar."
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Texto Botón Principal",
      "default": "Ver catálogo"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Enlace Botón Principal"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Texto Botón Secundario",
      "default": "Conócenos"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Enlace Botón Secundario"
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Métrica 1 Número",
      "default": "10K+"
    },
    {
      "type": "text",
      "id": "stat_1_lbl",
      "label": "Métrica 1 Etiqueta",
      "default": "Mascotas felices"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Métrica 2 Número",
      "default": "20+"
    },
    {
      "type": "text",
      "id": "stat_2_lbl",
      "label": "Métrica 2 Etiqueta",
      "default": "Productos"
    },
    {
      "type": "text",
      "id": "stat_3_num",
      "label": "Métrica 3 Número",
      "default": "4.9★"
    },
    {
      "type": "text",
      "id": "stat_3_lbl",
      "label": "Métrica 3 Etiqueta",
      "default": "Valoración media"
    },
    {
      "type": "text",
      "id": "stat_4_num",
      "label": "Métrica 4 Número",
      "default": "Gratis"
    },
    {
      "type": "text",
      "id": "stat_4_lbl",
      "label": "Métrica 4 Etiqueta",
      "default": "Envío desde $150.000"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Principal"
    }
  ]
}
{% endschema %}
