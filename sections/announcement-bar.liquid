<div class="announcement-bar">
  <div class="container announcement-content">
    <div class="announcement-ticker">
      <span class="ticker-item"><i class="fa-solid fa-sparkles"></i> <strong>CUPPETS LUXURY PET ACCESSORIES</strong> — Calidad & Confort</span>
      <span class="ticker-item"><i class="fa-solid fa-truck-fast"></i> <strong>ENVÍO GRATIS</strong> en compras mayores a ${{ settings.free_shipping_threshold | default: '99.000' }} COP</span>
      <span class="ticker-item"><i class="fa-solid fa-ticket"></i> <strong>15% OFF VIP</strong> con el código: <span class="promo-badge-btn" onclick="copyPromoCode('{{ settings.promo_code | default: 'CUPPETS15' }}')">{{ settings.promo_code | default: 'CUPPETS15' }} <i class="fa-regular fa-copy"></i></span></span>
    </div>
    <div class="announcement-right">
      <a href="https://wa.me/{{ settings.whatsapp_number | default: '573233056221' }}?text=Hola%20Cuppets!%20Quiero%20asesoria%20VIP" target="_blank" class="announcement-link"><i class="fa-brands fa-whatsapp"></i> Asesoría VIP</a>
      <a href="/pages/perfil-mascota" class="announcement-link"><i class="fa-solid fa-heart-pulse"></i> Mi Peludito</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Barra de Anuncios",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto del anuncio",
      "default": "¡Envío gratis por compras superiores a $99.000 COP!"
    }
  ]
}
{% endschema %}
