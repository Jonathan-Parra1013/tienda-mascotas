<div class="categories-section section-padding" id="categorias">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="section-subtitle"><i class="fa-solid fa-sparkles"></i> MUNDO PERROS &amp; GATOS</span>
      <h2 class="section-title-main">Explora por Categoría &amp; Especie</h2>
      <p class="section-description" style="margin: 0 auto;">Diseñadas meticulosamente para brindar el mayor confort y un estilo incomparable en cada paseo y descanso.</p>
    </div>

    <!-- Quick Species Banner Cards -->
    <div class="species-banner-cards-grid">
      <a href="/collections/all?pet=dog" class="species-banner-card dog-banner">
        <div class="species-banner-text">
          <span class="species-banner-badge">🐶 Todo para Perritos</span>
          <h3>Colección Canina Cuppets</h3>
          <p>Arneses anti-tirones, collares acolchados, correas elásticas y camas memory foam.</p>
          <span class="species-banner-cta">Ver Accesorios de Perro <i class="fa-solid fa-arrow-right"></i></span>
        </div>
        <div class="species-banner-icon">
          <i class="fa-solid fa-dog"></i>
        </div>
      </a>

      <a href="/collections/all?pet=cat" class="species-banner-card cat-banner">
        <div class="species-banner-text">
          <span class="species-banner-badge">🐱 Todo para Gatitos</span>
          <h3>Colección Felina Cuppets</h3>
          <p>Collares de terciopelo con cascabel antiahogo, arneses anti-escape y cuevas térmicas.</p>
          <span class="species-banner-cta">Ver Accesorios de Gato <i class="fa-solid fa-arrow-right"></i></span>
        </div>
        <div class="species-banner-icon">
          <i class="fa-solid fa-cat"></i>
        </div>
      </a>
    </div>

    <!-- 6 Category Cards -->
    <div class="categories-masonry-grid" id="categories-masonry" style="margin-top: 28px;">
      
      <!-- 1. Arneses & Pecheras -->
      <div class="category-card" onclick="window.location.href='/collections/all?category=arneses'">
        <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=700&q=80" alt="Arneses y Pecheras" loading="lazy">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-vest"></i> Anti-Tirones</span>
          <h3>Arneses &amp; Pecheras</h3>
          <p>Explorar Arneses <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

      <!-- 2. Collares & Placas -->
      <div class="category-card" onclick="window.location.href='/collections/all?category=collares'">
        <img src="https://images.unsplash.com/photo-1535294435445-d7249524ef2e?auto=format&fit=crop&w=700&q=80" alt="Collares y Placas" loading="lazy">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-tag"></i> Perros &amp; Gatos</span>
          <h3>Collares &amp; Placas</h3>
          <p>Explorar Collares <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

      <!-- 3. Correas de Paseo -->
      <div class="category-card" onclick="window.location.href='/collections/all?category=correas'">
        <img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=700&q=80" alt="Correas de Paseo" loading="lazy">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-route"></i> Paseo Seguro</span>
          <h3>Correas de Paseo</h3>
          <p>Ver Colección <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

      <!-- 4. Camas & Descanso -->
      <div class="category-card" onclick="window.location.href='/collections/all?category=camas'">
        <img src="https://images.unsplash.com/photo-1541599540903-216a46ca1dc0?auto=format&fit=crop&w=700&q=80" alt="Camas y Descanso" loading="lazy">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-bed"></i> Descanso Royal</span>
          <h3>Camas &amp; Descanso</h3>
          <p>Ver Camas <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

      <!-- 5. Juguetes & Entretenimiento -->
      <div class="category-card" onclick="window.location.href='/collections/all?category=juguetes'">
        <img src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=700&q=80" alt="Juguetes y Entretenimiento" loading="lazy">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-shapes"></i> Diversión Total</span>
          <h3>Juguetes &amp; Entretenimiento</h3>
          <p>Ver Juguetes <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

      <!-- 6. Higiene & Cuidado -->
      <div class="category-card" onclick="window.location.href='/collections/all?category=higiene'">
        <img src="https://images.unsplash.com/photo-1607923432780-7a9c30adcb73?auto=format&fit=crop&w=700&q=80" alt="Higiene y Cuidado" loading="lazy">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-pump-soap"></i> Salud &amp; Limpieza</span>
          <h3>Higiene &amp; Cuidado</h3>
          <p>Ver Productos <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

    </div>

    <!-- Promociones Banner -->
    <div onclick="window.location.href='/collections/all?category=promociones'" 
         style="margin-top: 24px; background: linear-gradient(135deg, var(--brand-purple) 0%, var(--brand-honey) 100%); border-radius: var(--radius-lg); padding: 28px 36px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; box-shadow: var(--shadow-md); transition: transform 0.2s ease, box-shadow 0.2s ease; overflow: hidden; position: relative;"
         onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 16px 40px rgba(92,59,255,0.35)'"
         onmouseout="this.style.transform=''; this.style.boxShadow='var(--shadow-md)'">
      <div>
        <span style="font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.8);">🔥 OFERTAS ESPECIALES</span>
        <h3 style="font-family: var(--font-display); font-size: clamp(1.3rem, 2.5vw, 1.8rem); color: #fff; margin: 6px 0 4px; font-weight: 800;">Promociones &amp; Combos Cuppets</h3>
        <p style="color: rgba(255,255,255,0.85); font-size: 0.95rem; max-width: 500px;">Sets, kits y combos exclusivos con hasta 40% de descuento. ¡No te los pierdas!</p>
      </div>
      <div style="display: flex; align-items: center; gap: 16px;">
        <span style="background: rgba(255,255,255,0.2); color: #fff; font-weight: 800; padding: 12px 24px; border-radius: var(--radius-full); font-size: 1rem; white-space: nowrap; border: 1.5px solid rgba(255,255,255,0.4);">
          Ver Promociones <i class="fa-solid fa-arrow-right"></i>
        </span>
        <div style="font-size: 3.5rem; opacity: 0.25; position: absolute; right: 28px; top: 50%; transform: translateY(-50%);">
          🏷️
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Grilla de Categorías",
  "settings": [],
  "presets": [
    {
      "name": "Grilla de Categorías"
    }
  ]
}
{% endschema %}
