<div class="categories-section section-padding">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="section-subtitle"><i class="fa-solid fa-sparkles"></i> MUNDO PERROS & GATOS</span>
      <h2 class="section-title-main">Categorías Destacadas</h2>
      <p class="section-description">Diseñadas meticulosamente para brindar el mayor confort y un estilo incomparable en cada momento.</p>
    </div>

    <div class="categories-masonry-grid" id="categories-masonry">
      <div class="category-card large" onclick="window.location.href='/collections/collares-y-correas'">
        <img src="https://images.unsplash.com/photo-1535294435445-d7249524ef2e?auto=format&fit=crop&w=800&q=80" alt="Collares y Correas">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-shield-dog"></i> Colección Principal</span>
          <h3>Collares & Correas Padded</h3>
          <p>Explorar Accesorios <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

      <div class="category-card" onclick="window.location.href='/collections/arneses-y-pecheras'">
        <img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=600&q=80" alt="Arneses y Pecheras">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-vest"></i> Anti-Tirones</span>
          <h3>Arneses Ergonómicos</h3>
          <p>Ver Modelos <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

      <div class="category-card" onclick="window.location.href='/collections/correas-y-paseo'">
        <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=600&q=80" alt="Correas de Paseo">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-route"></i> Paseo Seguro</span>
          <h3>Correas & Manos Libres</h3>
          <p>Ver Colección <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>

      <div class="category-card" onclick="window.location.href='/collections/camas-y-cojines'">
        <img src="https://images.unsplash.com/photo-1541599540903-216a46ca1dc0?auto=format&fit=crop&w=600&q=80" alt="Camas y Cojines">
        <div class="category-overlay">
          <span class="category-badge"><i class="fa-solid fa-bed"></i> Descanso Royal</span>
          <h3>Camas Ortopédicas</h3>
          <p>Conocer Más <i class="fa-solid fa-arrow-right"></i></p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Grilla de Categorías",
  "settings": []
}
{% endschema %}
