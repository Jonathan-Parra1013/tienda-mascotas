<div class="featured-section section-padding" id="catalogo-destacado">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="section-subtitle"><i class="fa-solid fa-sparkles"></i> CATÁLOGO EXCLUSIVO CUPPETS</span>
      <h2 class="section-title-main">{{ section.settings.title | default: 'Colección Diseñada para su Bienestar' }}</h2>
      <p class="section-description" style="margin: 0 auto;">
        Selecciona a tu compañero favorito y descubre collares acolchados, arneses anti-tirones y camas ergonómicas.
      </p>
    </div>

    <!-- Interactive Pet Filter Switcher Tabs (Perros / Gatos / Todos) -->
    <div class="pet-catalog-tabs-container">
      <div class="pet-catalog-tabs" role="tablist" aria-label="Filtrar por tipo de mascota">
        <button class="pet-tab-btn active" data-pet="all" onclick="filterCatalogByPet('all', this)">
          <i class="fa-solid fa-paw"></i>
          <span>Todos los Accesorios</span>
          <span class="pet-tab-counter" id="count-all">8</span>
        </button>
        <button class="pet-tab-btn" data-pet="dog" onclick="filterCatalogByPet('dog', this)">
          <i class="fa-solid fa-dog"></i>
          <span>🐶 Para Perros</span>
          <span class="pet-tab-counter" id="count-dog">4</span>
        </button>
        <button class="pet-tab-btn" data-pet="cat" onclick="filterCatalogByPet('cat', this)">
          <i class="fa-solid fa-cat"></i>
          <span>🐱 Para Gatos</span>
          <span class="pet-tab-counter" id="count-cat">4</span>
        </button>
      </div>
    </div>

    <!-- Products Grid Container -->
    <div class="products-grid" id="catalog-products-grid">
      {% assign featured_collection = collections[section.settings.collection] | default: collections.all %}
      {% if featured_collection and featured_collection.products.size > 0 %}
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {% assign pet_type = 'all' %}
          {% assign prod_text = product.title | append: ' ' | append: product.description | append: ' ' | append: product.tags | append: ' ' | append: product.type | downcase %}
          {% if prod_text contains 'perro' or prod_text contains 'canin' or prod_text contains 'dog' or prod_text contains 'cachorro' %}
            {% if prod_text contains 'gato' or prod_text contains 'felin' or prod_text contains 'cat' or prod_text contains 'michi' %}
              {% assign pet_type = 'both' %}
            {% else %}
              {% assign pet_type = 'dog' %}
            {% endif %}
          {% elsif prod_text contains 'gato' or prod_text contains 'felin' or prod_text contains 'cat' or prod_text contains 'michi' or prod_text contains 'minino' %}
            {% assign pet_type = 'cat' %}
          {% endif %}

          {% assign prod_cat = 'accesorios' %}
          {% if prod_text contains 'combo' or prod_text contains 'promo' or prod_text contains 'kit ' or prod_text contains 'set ' or prod_text contains 'pack' or prod_text contains 'descuento' or prod_text contains 'oferta' %}
            {% assign prod_cat = 'promociones' %}
          {% elsif prod_text contains 'dient' or prod_text contains 'dental' or prod_text contains 'cepillo' or prod_text contains 'sarro' or prod_text contains 'higien' or prod_text contains 'shampoo' or prod_text contains 'cortauna' or prod_text contains 'limpia' or prod_text contains 'baño' or prod_text contains 'jabon' or prod_text contains 'peine' or prod_text contains 'grooming' %}
            {% assign prod_cat = 'higiene' %}
          {% elsif prod_text contains 'arnes' or prod_text contains 'pecher' or prod_text contains 'chaleco' %}
            {% assign prod_cat = 'arneses' %}
          {% elsif prod_text contains 'collar' or prod_text contains 'chapa' or prod_text contains 'medalla' or prod_text contains 'identificad' or prod_text contains 'tag' or prod_text contains 'placa' %}
            {% assign prod_cat = 'collares' %}
          {% elsif prod_text contains 'correa' or prod_text contains 'paseo' or prod_text contains 'lazo' or prod_text contains 'guia' %}
            {% assign prod_cat = 'correas' %}
          {% elsif prod_text contains 'cama' or prod_text contains 'cueva' or prod_text contains 'iglu' or prod_text contains 'colchon' or prod_text contains 'cojin' or prod_text contains 'descanso' %}
            {% assign prod_cat = 'camas' %}
          {% elsif prod_text contains 'juguet' or prod_text contains 'pelota' or prod_text contains 'cuerda' or prod_text contains 'rascador' or prod_text contains 'interactiv' or prod_text contains 'mordedor' or prod_text contains 'peluche' %}
            {% assign prod_cat = 'juguetes' %}
          {% endif %}
          <div class="catalog-product-item" data-pet-type="{{ pet_type }}" data-category="{{ prod_cat }}" data-price="{{ product.price | divided_by: 100.0 }}" data-rating="5" data-title="{{ product.title | escape }}">
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Rich Built-In Functional Interactive Catalog (4 Perros + 4 Gatos) -->
        <!-- 🐶 DOG PRODUCTS -->
