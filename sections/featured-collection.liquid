{% schema %}
{
  "name": "Colección Destacada",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "Colección Diseñada para su Bienestar"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección a mostrar"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8,
      "label": "Número de productos a mostrar"
    }
  ],
  "presets": [
    {
      "name": "Colección Destacada"
    }
  ]
}
{% endschema %}
