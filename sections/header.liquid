<header class="main-header" id="main-header">
  <!-- Top Row: Brand Logo, Species Switcher, Quick Search, Action Buttons -->
  <div class="container header-top-row">
    
    <!-- Official Brand Logo -->
    <a href="/" class="brand-logo" aria-label="Cuppets - Inicio">
      <img src="{{ 'cuppets-logo.png' | asset_url }}" alt="Cuppets Logo" class="brand-logo-img" width="52" height="52">
      <div class="logo-text-box">
        <div class="brand-title-split">
          <span class="cup">Cup</span><span class="pets">pets</span>
        </div>
        <span class="brand-subtitle-slogan">Todo para consentir a tu mejor amigo</span>
      </div>
    </a>

    <!-- Species Switcher (Shopify Collection Filter) -->
    <div class="species-switcher" id="species-switcher" role="tablist" aria-label="Filtrar por especie">
      <button class="switcher-btn active" data-type="all" onclick="filterByPetType('all')">
        <i class="fa-solid fa-border-all"></i> Todos
      </button>
      <button class="switcher-btn" data-type="dog" onclick="filterByPetType('dog')">
        <i class="fa-solid fa-dog"></i> Perros
      </button>
      <button class="switcher-btn" data-type="cat" onclick="filterByPetType('cat')">
        <i class="fa-solid fa-cat"></i> Gatos
      </button>
    </div>

    <!-- Quick Search Bar & Trigger -->
    <div class="header-search-box" onclick="openSearchModal()" role="button" aria-label="Buscar productos">
      <i class="fa-solid fa-magnifying-glass search-icon" style="color: var(--brand-purple);"></i>
      <span class="search-placeholder">Buscar collares, arneses, camas...</span>
      <kbd class="search-kbd">⌘K</kbd>
    </div>

    <!-- Right Action Icons -->
    <div class="header-actions">
      <button class="header-btn" onclick="openAccountDrawer()" title="Mi Cuenta">
        <i class="fa-regular fa-user"></i>
        <span class="header-btn-text" id="header-user-name">
          {% if customer %}{{ customer.first_name }}{% else %}Mi Cuenta{% endif %}
        </span>
      </button>

      <button class="header-btn cart-trigger-btn" onclick="toggleCartDrawer()" title="Ver Canasta">
        <div class="cart-icon-box">
          <i class="fa-solid fa-basket-shopping"></i>
          <span class="cart-count-badge" id="cart-badge">{{ cart.item_count }}</span>
        </div>
        <span class="cart-header-subtotal" id="cart-subtotal-header">${{ cart.total_price | money_without_currency }}</span>
      </button>

      <button class="mobile-toggle" onclick="toggleMobileMenu()" aria-label="Abrir menú">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>

  <!-- Navigation Bar -->
  <nav class="nav-bar">
    <div class="container nav-container">
      <ul class="nav-menu" id="nav-menu">
        <li class="nav-item"><a href="/" class="nav-link {% if request.path == '/' %}active{% endif %}">Inicio</a></li>
        <li class="nav-item"><a href="/collections/all" class="nav-link {% if request.path contains '/collections/all' %}active{% endif %}">Catálogo Completo</a></li>
        <li class="nav-item"><a href="/collections/perros" class="nav-link"><i class="fa-solid fa-dog" style="color: var(--brand-honey);"></i> Perros</a></li>
        <li class="nav-item"><a href="/collections/gatos" class="nav-link"><i class="fa-solid fa-cat" style="color: var(--brand-purple);"></i> Gatos</a></li>
        <li class="nav-item dropdown">
          <a href="/collections/collares-y-correas" class="nav-link">
            Categorías <i class="fa-solid fa-chevron-down arrow-icon" style="font-size:0.75rem; opacity:0.7;"></i>
          </a>
          <div class="dropdown-content">
            <a href="/collections/collares">Collares y Pecheras</a>
            <a href="/collections/arneses">Arneses Ergonómicos</a>
            <a href="/collections/correas">Correas de Paseo</a>
            <a href="/collections/camas">Camas y Descanso</a>
          </div>
        </li>
        <li class="nav-item"><a href="/pages/sobre-nosotros" class="nav-link">Sobre Nosotros</a></li>
      </ul>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Encabezado y Menú",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de la marca"
    }
  ]
}
{% endschema %}
