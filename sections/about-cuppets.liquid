<div class="institutional-section section-padding" id="sobre-nosotros">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="section-subtitle"><i class="fa-solid fa-heart"></i> TODO PARA EL BIENESTAR DE TU MASCOTA</span>
      <h2 class="section-title-main">El Compromiso y Calidad Cuppets</h2>
      <p class="section-description">Nacimos con el propósito de ofrecer tecnología inteligente, accesorios ergonómicos y productos de higiene que hacen la vida de perros y gatos más feliz y saludable.</p>
    </div>

    <!-- Comparison Table -->
    <div class="comparison-table-wrapper" style="max-width: 900px; margin: 0 auto;">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Especificación</th>
            <th class="col-cuppets"><i class="fa-solid fa-paw"></i> Cuppets Original</th>
            <th class="col-standard">Accesorios Genéricos</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Tecnología &amp; Seguridad</strong></td>
            <td class="col-cuppets"><i class="fa-solid fa-check text-purple"></i> Sensores inteligentes y motores ultra silenciosos</td>
            <td class="col-standard"><i class="fa-solid fa-xmark text-muted"></i> Motores ruidosos que asustan a la mascota</td>
          </tr>
          <tr>
            <td><strong>Materiales &amp; Higiene</strong></td>
            <td class="col-cuppets"><i class="fa-solid fa-check text-purple"></i> Silicona grado médico y materiales hipoalergénicos</td>
            <td class="col-standard"><i class="fa-solid fa-xmark text-muted"></i> Plásticos rígidos y cerdas ásperas</td>
          </tr>
          <tr>
            <td><strong>Diseño &amp; Ergonomía</strong></td>
            <td class="col-cuppets"><i class="fa-solid fa-check text-purple"></i> Iluminación LED, antideslizante y fácil limpieza</td>
            <td class="col-standard"><i class="fa-solid fa-xmark text-muted"></i> Diseños pesados e incómodos</td>
          </tr>
          <tr>
            <td><strong>Garantía y Soporte</strong></td>
            <td class="col-cuppets"><i class="fa-solid fa-check text-purple"></i> Garantía oficial y asesoría personalizada por WhatsApp</td>
            <td class="col-standard"><i class="fa-solid fa-xmark text-muted"></i> Sin respaldo ni soporte</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

