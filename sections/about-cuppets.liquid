<div class="institutional-section section-padding">
  <div class="container">
    <div class="section-title-box text-center">
      <span class="section-subtitle"><i class="fa-solid fa-heart"></i> TODO PARA CONSENTIR A TU MEJOR AMIGO</span>
      <h2 class="section-title-main">El Compromiso Cuppets</h2>
      <p class="section-description">Nacimos del amor incondicional por los perros y gatos. Cada accesorio combina ergonomía veterinaria, resistencia insuperable y la máxima suavidad.</p>
    </div>

    <!-- Comparison Table -->
    <div class="comparison-table-wrapper" style="max-width: 900px; margin: 0 auto;">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Especificación</th>
            <th class="col-cuppets"><i class="fa-solid fa-paw"></i> Cuppets Original</th>
            <th class="col-standard">Accesorios Genéricos</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Material Textil</strong></td>
            <td class="col-cuppets"><i class="fa-solid fa-check text-purple"></i> Nylon Acolchado Hipoalergénico</td>
            <td class="col-standard"><i class="fa-solid fa-xmark text-muted"></i> Sintético rígido que causa roces</td>
          </tr>
          <tr>
            <td><strong>Herrajes & Hebillas</strong></td>
            <td class="col-cuppets"><i class="fa-solid fa-check text-purple"></i> Aleación Inoxidable Ultra Resistente</td>
            <td class="col-standard"><i class="fa-solid fa-xmark text-muted"></i> Plástico quebradizo</td>
          </tr>
          <tr>
            <td><strong>Ergonomía & Seguridad</strong></td>
            <td class="col-cuppets"><i class="fa-solid fa-check text-purple"></i> Distribución de Tracción Antiahogo</td>
            <td class="col-standard"><i class="fa-solid fa-xmark text-muted"></i> Presión en el cuello</td>
          </tr>
          <tr>
            <td><strong>Garantía de Fábrica</strong></td>
            <td class="col-cuppets"><i class="fa-solid fa-check text-purple"></i> 1 Año Completo de Garantía</td>
            <td class="col-standard"><i class="fa-solid fa-xmark text-muted"></i> Sin respaldo</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Institucional y Calidad",
  "settings": [],
  "presets": [
    {
      "name": "Institucional y Calidad"
    }
  ]
}
{% endschema %}
